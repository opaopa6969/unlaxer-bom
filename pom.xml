<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.unlaxer</groupId>
    <artifactId>unlaxer-bom</artifactId>
    <!-- リリーストレイン番号（CalVer YYYY.MM）。各 artifact は独立 SemVer のまま。
         このトレインに含まれる「検証済みの組み合わせ」を dependencyManagement で固定する。
         履歴と検証エビデンスは CHANGELOG.md（現在値はこの pom、過去と根拠は doc の二層）。 -->
    <version>2026.23</version>
    <packaging>pom</packaging>

    <name>unlaxer-bom</name>
    <description>vacant 製品群の共通 BOM。全製品で共有する unlaxer artifact（common / building-hierarchy /
        abr-utils / onigiri-parser / 予定: jaddress-rdb-api）と検証済み 3rdパーティ（doma / flyway）の
        バージョンセットを固定する。製品固有の rdb 実装・service は製品 BOM（vacant-bom 等）が import して固定する。
        設計: docs/design/vacant-bom-rdb-architecture.md。</description>
    <url>https://github.com/opaopa6969/unlaxer-bom</url>

    <properties>
        <!-- このトレインの構成バージョン。CHANGELOG.md の同名トレインと一致させること。 -->
        <unlaxer-common.version>2.8.0</unlaxer-common.version>
        <japanese-parser-common.version>0.1.1</japanese-parser-common.version>
        <building-hierarchy.version>0.14.1</building-hierarchy.version>
        <abr-utils.version>0.10.8</abr-utils.version>
        <onigiri-parser.version>0.9.13</onigiri-parser.version>
        <!-- 歴史地名辞書(町名照合失敗時の字消費 fallback)とその依存(自治体統廃合履歴)。onigiri 0.9.11 が利用。 -->
        <historical-town-names.version>0.1.0</historical-town-names.version>
        <municipality-history.version>1.0.1</municipality-history.version>
        <!-- 検証済み 3rdパーティ。各 rdb 実装 / consumer が BOM 経由で揃える（drift 防止）。 -->
        <doma.version>3.6.0</doma.version>
        <flyway.version>12.1.0</flyway.version>
        <!-- Phase 1 で新設予定の port artifact。公開前のため version 予約のみ（下の dependencyManagement では未登録）。 -->
        <!-- <jaddress-rdb-api.version>0.1.0</jaddress-rdb-api.version> -->
    </properties>

    <distributionManagement>
        <!-- 単一ホスト方式: 全 unlaxer artifact をこの registry に集約（GitHub Packages、issue onigiri-parser#78） -->
        <repository>
            <id>github-unlaxer</id>
            <name>GitHub Packages (unlaxer)</name>
            <url>https://maven.pkg.github.com/opaopa6969/unlaxer-bom</url>
        </repository>
    </distributionManagement>

    <dependencyManagement>
        <dependencies>
            <!-- 全リポ共通基盤。トレイン内で厳密統一を強制する唯一の artifact（1.1.26/2.8.0 事故の再発防止）。 -->
            <dependency>
                <groupId>org.unlaxer</groupId>
                <artifactId>unlaxer-common</artifactId>
                <version>${unlaxer-common.version}</version>
            </dependency>
            <!-- 日本語住所テキスト処理共通(文字種/CodePoint モデル・正規化・tokenizer・translator核)。
                 onigiri-parser から抽出し onigiri / abr-utils が共有。 -->
            <dependency>
                <groupId>org.unlaxer</groupId>
                <artifactId>japanese-parser-common</artifactId>
                <version>${japanese-parser-common.version}</version>
            </dependency>
            <!-- 住所→建物階層パーサー。 -->
            <dependency>
                <groupId>org.unlaxer</groupId>
                <artifactId>building-hierarchy</artifactId>
                <version>${building-hierarchy.version}</version>
            </dependency>
            <!-- ABRUtils（住所検索本体・作法の基準）。groupId は org.unlaxer.geo。 -->
            <dependency>
                <groupId>org.unlaxer.geo</groupId>
                <artifactId>abr-utils</artifactId>
                <version>${abr-utils.version}</version>
            </dependency>
            <!-- onigiri 住所パーサー。 -->
            <dependency>
                <groupId>org.unlaxer</groupId>
                <artifactId>onigiri-parser</artifactId>
                <version>${onigiri-parser.version}</version>
            </dependency>
            <!-- 歴史地名辞書(町名照合失敗時の字消費 fallback。onigiri 0.9.11 が利用)。 -->
            <dependency>
                <groupId>org.unlaxer</groupId>
                <artifactId>historical-town-names</artifactId>
                <version>${historical-town-names.version}</version>
            </dependency>
            <!-- 自治体統廃合履歴(historical-town-names の依存)。 -->
            <dependency>
                <groupId>org.unlaxer</groupId>
                <artifactId>municipality-history</artifactId>
                <version>${municipality-history.version}</version>
            </dependency>

            <!-- ▼ 検証済み 3rdパーティ（doma / flyway）。各 rdb 実装・consumer はここで版が揃う。 -->
            <!-- Doma 2/3: SQL/DAO フレームワーク。 -->
            <dependency>
                <groupId>org.seasar.doma</groupId>
                <artifactId>doma-core</artifactId>
                <version>${doma.version}</version>
            </dependency>
            <dependency>
                <groupId>org.seasar.doma</groupId>
                <artifactId>doma-processor</artifactId>
                <version>${doma.version}</version>
            </dependency>
            <!-- Flyway: スキーマ migration。 -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- Phase 1 で jaddress-rdb-api（port）を追加予定。公開後に下記を有効化:
            <dependency>
                <groupId>org.unlaxer</groupId>
                <artifactId>jaddress-rdb-api</artifactId>
                <version>${jaddress-rdb-api.version}</version>
            </dependency>
            -->
        </dependencies>
    </dependencyManagement>
</project>
